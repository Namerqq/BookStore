<Window x:Class="BookStore.View.Manager.VoucherManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Voucher khuyến mãi" Height="700" Width="1100" WindowStartupLocation="CenterScreen">

    <Grid Background="#F4F4F5" Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Cột trái: Form điền thông tin -->
            <ColumnDefinition Width="350"/>
            <!-- Cột phải: DataGrid -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM THÊM / SỬA -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#ddd" BorderThickness="1" Padding="20" Margin="0,0,20,0">
            <StackPanel>
                <TextBlock Text="Thông tin Voucher" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ID ẩn dùng để nhận biết Thêm hay Sửa -->
                <TextBlock x:Name="txtVoucherId" Visibility="Collapsed" Text="0"/>

                <TextBlock Text="Mã Code *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtCode" Height="35" Padding="5" Margin="0,0,0,15" CharacterCasing="Upper"/>

                <TextBlock Text="Mức giảm giá (VNĐ) *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDiscount" Height="35" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Đơn tối thiểu (VNĐ)" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMinOrder" Height="35" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Hạn sử dụng" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="dpValidUntil" Height="35" Margin="0,0,0,30"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Làm mới" Width="80" Height="35" Background="#eee" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnClearForm_Click"/>
                    <Button Content="Lưu Voucher" Width="100" Height="35" Background="#C2542D" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- DANH SÁCH & CÔNG CỤ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Tìm kiếm -->
                <TextBox x:Name="txtSearch" Height="35" Padding="5" TextChanged="TxtSearch_TextChanged" Tag="Tìm mã code..."/>

                <!-- Xuất CSV -->
                <Button Grid.Column="1" Content="⬇ Xuất File CSV" HorizontalAlignment="Right" Background="#2ecc71" Foreground="White" FontWeight="Bold" Padding="15,0" Height="35" BorderThickness="0" Cursor="Hand" Click="BtnExportCSV_Click"/>
            </Grid>

            <DataGrid x:Name="dgVouchers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                      Background="White" BorderBrush="#ddd" BorderThickness="1" RowHeight="40" SelectionChanged="DgVouchers_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding VoucherId}" Width="50"/>
                    <DataGridTextColumn Header="Mã Voucher" Binding="{Binding Code}" Width="150"/>
                    <DataGridTextColumn Header="Giảm (VNĐ)" Binding="{Binding DiscountValue, StringFormat={}{0:N0}}" Width="100"/>
                    <DataGridTextColumn Header="Đơn tối thiểu" Binding="{Binding MinOrderValue, StringFormat={}{0:N0}}" Width="120"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="100"/>

                    <DataGridTemplateColumn Header="Hành động" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Bật/Tắt" Background="#1e2632" Foreground="White" Padding="10,2" Cursor="Hand"
                                        CommandParameter="{Binding VoucherId}" Click="BtnToggle_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>