<Window x:Class="BookStore.View.Manager.ProductManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Sản Phẩm" Height="760" Width="1220" WindowStartupLocation="CenterScreen" Background="#Fcfbfa" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: FORM NHẬP LIỆU -->
        <Border Grid.Column="0" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,15,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="THÔNG TIN SẢN PHẨM" FontSize="16" FontWeight="Bold" Foreground="#1e2632" VerticalAlignment="Center"/>
                        <Button Content="Làm mới" HorizontalAlignment="Right" Padding="10,4" Background="#ecf0f1" BorderThickness="0" Cursor="Hand" Click="BtnClear_Click"/>
                    </Grid>

                    <TextBlock Text="Mã SKU *" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtSku" Height="30" Padding="5,2" Margin="0,0,0,2" LostFocus="TxtSku_LostFocus" TextChanged="TxtSku_TextChanged" VerticalContentAlignment="Center" MaxLength="50"/>
                    <TextBlock x:Name="lblSkuWarning" Text="" Foreground="#e74c3c" FontSize="11" Margin="0,0,0,8" Visibility="Collapsed"/>

                    <TextBlock Text="Tên sản phẩm *" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtName" Height="30" Padding="5,2" Margin="0,0,0,8" VerticalContentAlignment="Center" MaxLength="200"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Danh mục *" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                            <ComboBox x:Name="cbCategory" Height="30" DisplayMemberPath="Name" SelectedValuePath="CategoryId"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Loại sản phẩm *" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                            <ComboBox x:Name="cbProductType" Height="30" SelectedIndex="0" SelectionChanged="CbProductType_SelectionChanged">
                                <ComboBoxItem Content="Sách" Tag="BOOK"/>
                                <ComboBoxItem Content="Văn phòng phẩm" Tag="STATIONERY"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Giá vốn (UnitCost) *" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtUnitCost" Height="30" Padding="5,2" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Giá trước VAT *" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtPrice" Height="30" Padding="5,2" TextChanged="TxtPrice_TextChanged" LostFocus="TxtPrice_LostFocus" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="lblVatPrice" Text="Giá bán sau VAT (x1.1): 0 VNĐ" FontWeight="Bold" Foreground="#C2542D" FontSize="12" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tồn kho *" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtStock" Height="30" Padding="5,2" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cân nặng (gram)" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtWeight" Height="30" Padding="5,2" VerticalContentAlignment="Center" Text="300"/>
                        </StackPanel>
                    </Grid>

                    <!-- Thuộc tính sách -->
                    <StackPanel x:Name="pnlBookFields">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tác giả" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtAuthor" Height="30" Padding="5,2" VerticalContentAlignment="Center" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ISBN" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtIsbn" Height="30" Padding="5,2" VerticalContentAlignment="Center" MaxLength="30"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nhà xuất bản" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtPublisher" Height="30" Padding="5,2" VerticalContentAlignment="Center" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Năm XB" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtPublicationYear" Height="30" Padding="5,2" VerticalContentAlignment="Center" MaxLength="4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Thuộc tính văn phòng phẩm -->
                    <StackPanel x:Name="pnlStationeryFields" Visibility="Collapsed">
                        <TextBlock Text="Thương hiệu" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtBrand" Height="30" Padding="5,2" Margin="0,0,0,8" VerticalContentAlignment="Center" MaxLength="100"/>

                        <TextBlock Text="Thông số kỹ thuật" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtSpecifications" Height="48" Padding="5,4" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <TextBlock Text="Mô tả sản phẩm" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtDescription" Height="56" Padding="5,4" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Text="Hình ảnh sản phẩm:" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Chọn ảnh..." Width="90" Height="30" Background="#f0f0f0" BorderThickness="0" Click="BtnBrowseImage_Click" Cursor="Hand"/>
                        <TextBlock x:Name="lblImagePath" Text="Chưa chọn file" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888" TextTrimming="CharacterEllipsis" Width="260"/>
                    </StackPanel>

                    <!-- Nút thao tác -->
                    <UniformGrid Columns="3" Height="36">
                        <Button Content="Thêm mới" Background="#27ae60" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" Click="BtnAdd_Click"/>
                        <Button Content="Cập nhật" Background="#2980b9" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="2,0,2,0" Cursor="Hand" Click="BtnUpdate_Click"/>
                        <Button x:Name="btnToggleStatus" Content="Ngừng/Mở bán" Background="#c0392b" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="5,0,0,0" Cursor="Hand" Click="BtnDiscontinue_Click"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- CỘT PHẢI: DANH SÁCH SẢN PHẨM -->
        <Border Grid.Column="1" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="DANH SÁCH SẢN PHẨM TRONG HỆ THỐNG" FontSize="16" FontWeight="Bold" Foreground="#1e2632" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtManagerSearch" Width="230" Height="30" Padding="8,2" HorizontalAlignment="Right" VerticalContentAlignment="Center"
                             ToolTip="Tìm theo tên hoặc SKU" TextChanged="TxtManagerSearch_TextChanged"/>
                </Grid>

                <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgProducts_SelectionChanged" Background="White" BorderBrush="#e0e0e0" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="85"/>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Giá VAT" Binding="{Binding Price, StringFormat={}{0:N0}đ}" Width="100"/>
                        <DataGridTextColumn Header="Giá vốn" Binding="{Binding UnitCost, StringFormat={}{0:N0}đ}" Width="90"/>
                        <DataGridTextColumn Header="Tồn" Binding="{Binding StockQuantity}" Width="55"/>
                        <DataGridTextColumn Header="Nặng(g)" Binding="{Binding WeightGrams}" Width="65"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding ProductType}" Width="90"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="105"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
