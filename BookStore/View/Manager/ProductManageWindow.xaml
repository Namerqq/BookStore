<Window x:Class="BookStore.View.Manager.ProductManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Sản Phẩm" Height="700" Width="1100" WindowStartupLocation="CenterScreen" Background="#Fcfbfa">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: FORM NHẬP LIỆU -->
        <Border Grid.Column="0" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,15,0">
            <StackPanel>
                <TextBlock Text="THÔNG TIN SẢN PHẨM" FontSize="16" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,0,15"/>

                <TextBlock Text="Mã SKU:" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                <TextBox x:Name="txtSku" Height="30" Margin="0,0,0,10" LostFocus="TxtSku_LostFocus" VerticalContentAlignment="Center"/>

                <TextBlock Text="Tên sản phẩm:" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                <TextBox x:Name="txtName" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Danh mục:" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbCategory" Height="30" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="CategoryId"/>

                <TextBlock Text="Loại sản phẩm:" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbProductType" Height="30" Margin="0,0,0,10" SelectedIndex="0">
                    <ComboBoxItem Content="Sách" Tag="BOOK"/>
                    <ComboBoxItem Content="Văn phòng phẩm" Tag="STATIONERY"/>
                </ComboBox>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="160" Margin="0,0,10,0">
                        <TextBlock Text="Giá vốn (UnitCost):" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtUnitCost" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Width="160">
                        <TextBlock Text="Giá gốc (Price):" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtPrice" Height="30" Margin="0,0,0,10" LostFocus="TxtPrice_LostFocus" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="lblVatPrice" Text="Giá bán sau VAT (x1.1): 0 VNĐ" FontWeight="Bold" Foreground="#C2542D" FontSize="12" Margin="0,0,0,10"/>

                <TextBlock Text="Số lượng tồn kho:" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                <TextBox x:Name="txtStock" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Hình ảnh sản phẩm:" FontWeight="Bold" FontSize="11" Foreground="#555" Margin="0,0,0,3"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="Chọn ảnh..." Width="90" Height="30" Background="#f0f0f0" BorderThickness="0" Click="BtnBrowseImage_Click" Cursor="Hand"/>
                    <TextBlock x:Name="lblImagePath" Text="Chưa chọn file" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#888" TextTrimming="CharacterEllipsis" Width="200"/>
                </StackPanel>

                <!-- Nút thao tác -->
                <UniformGrid Columns="3" Height="35">
                    <Button Content="Thêm mới" Background="#27ae60" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand" Click="BtnAdd_Click"/>
                    <Button Content="Cập nhật" Background="#2980b9" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="2,0,2,0" Cursor="Hand" Click="BtnUpdate_Click"/>
                    <Button Content="Ngừng bán" Background="#c0392b" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="5,0,0,0" Cursor="Hand" Click="BtnDiscontinue_Click"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- CỘT PHẢI: DANH SÁCH SẢN PHẨM -->
        <Border Grid.Column="1" Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="DANH SÁCH SẢN PHẨM TRONG HỆ THỐNG" FontSize="16" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,0,15"/>

                <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgProducts_SelectionChanged" Background="White" BorderBrush="#e0e0e0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="75"/>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Giá VAT" Binding="{Binding Price, StringFormat={}{0:N0}đ}" Width="110"/>
                        <DataGridTextColumn Header="Tồn kho" Binding="{Binding StockQuantity}" Width="65"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding ProductType}" Width="90"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>