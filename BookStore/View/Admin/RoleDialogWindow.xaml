<Window x:Class="BookStore.View.Admin.RoleDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn quyền mới" Height="200" Width="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Background="White" Margin="20">
        <StackPanel>
            <TextBlock Text="Chọn quyền cho tài khoản:" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

            <ComboBox x:Name="cmbRoles" Height="30" FontSize="14" Margin="0,0,0,20">
                <ComboBoxItem Content="CUSTOMER" Tag="CUSTOMER"/>
                <ComboBoxItem Content="STAFF" Tag="STAFF"/>
                <ComboBoxItem Content="MANAGER" Tag="MANAGER"/>
                <ComboBoxItem Content="ADMIN" Tag="ADMIN"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="80" Height="30" Margin="0,0,10,0" Background="#f5f5f5" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Lưu" Width="80" Height="30" Background="#1e2632" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>