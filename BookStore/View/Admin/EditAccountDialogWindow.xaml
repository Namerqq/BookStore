<Window x:Class="BookStore.View.Admin.EditAccountDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa thông tin tài khoản" Height="340" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Background="#F8FAFC" Margin="20">
        <StackPanel>
            <TextBlock Text="Cập nhật thông tin tài khoản" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,16"/>

            <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="txtEmail" Height="32" Padding="6,4" Margin="0,0,0,12" IsReadOnly="True" Background="#E2E8F0" Foreground="#475569"/>

            <TextBlock Text="Họ và tên *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="txtFullName" Height="32" Padding="6,4" Margin="0,0,0,12" MaxLength="100"/>

            <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="txtPhone" Height="32" Padding="6,4" Margin="0,0,0,22" MaxLength="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="80" Height="34" Background="#E2E8F0" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Lưu thay đổi" Width="110" Height="34" Background="#C2542D" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
