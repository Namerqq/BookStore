<Window x:Class="BookStore.View.Admin.AdminAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý tài khoản — Admin | Booky Mart" Height="600" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Quản lý tài khoản" FontSize="24" FontWeight="Bold" Foreground="#1e2632"/>
            <TextBlock Text="Tạo, sửa, vô hiệu hóa tài khoản Staff và Manager" FontSize="14" Foreground="#7f8c8d"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBox x:Name="txtSearch" Width="250" Padding="8" Margin="0,0,10,0" ToolTip="Tìm theo tên, email..."/>
                <ComboBox x:Name="cboRoleFilter" Width="120" Padding="5" Margin="0,0,10,0">
                    <ComboBoxItem Content="Tất cả vai trò" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="CUSTOMER" Tag="CUSTOMER"/>
                    <ComboBoxItem Content="STAFF" Tag="STAFF"/>
                    <ComboBoxItem Content="MANAGER" Tag="MANAGER"/>
                    <ComboBoxItem Content="ADMIN" Tag="ADMIN"/>
                </ComboBox>
                <Button Content="Tìm kiếm" Click="BtnSearch_Click" Padding="15,5" Background="#1e2632" Foreground="White" BorderThickness="0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="+ Thêm tài khoản" Click="BtnAddAccount_Click" 
                    Background="#C2542D" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0"/>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="dgAccounts" AutoGenerateColumns="False" CanUserAddRows="False" 
                  IsReadOnly="True" Background="White" RowHeight="40" AlternatingRowBackground="#f9f9f9" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="1.5*"/>
                <DataGridTextColumn Header="Vai trò" Binding="{Binding Role}" Width="1*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1*"/>

                <DataGridTemplateColumn Header="Thao tác" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Sửa" Click="BtnEdit_Click" Tag="{Binding AccountId}" Margin="0,0,5,0" Padding="10,2" Background="#f1c40f" BorderThickness="0"/>
                                <Button Content="Khóa/Mở" Click="BtnToggleStatus_Click" Tag="{Binding AccountId}" Padding="10,2" Background="#e74c3c" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>