<Window x:Class="BookStore.View.Admin.AdminAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Tài khoản &amp; Phân quyền" Height="700" Width="1120" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Grid Background="#F4F4F5" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="Quản lý Tài khoản" FontSize="24" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,0,20"/>

        <!-- Thanh công cụ: Tìm kiếm & Lọc -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Tìm kiếm -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#ddd" BorderThickness="1" Padding="10,5" Margin="0,0,15,0">
                <Grid>
                    <TextBlock x:Name="txtSearchPlaceholder" Text="🔍 Tìm Email, Họ tên, SĐT..." Foreground="#999" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                </Grid>
            </Border>

            <!-- Lọc Role -->
            <ComboBox x:Name="cmbRoleFilter" Grid.Column="1" VerticalAlignment="Center" Height="32" SelectionChanged="CmbRoleFilter_SelectionChanged">
                <ComboBoxItem Content="Tất cả quyền" Tag="ALL" IsSelected="True"/>
                <ComboBoxItem Content="ADMIN" Tag="ADMIN"/>
                <ComboBoxItem Content="MANAGER" Tag="MANAGER"/>
                <ComboBoxItem Content="STAFF" Tag="STAFF"/>
                <ComboBoxItem Content="CUSTOMER" Tag="CUSTOMER"/>
            </ComboBox>

            <!-- Nút Thêm mới -->
            <Button Grid.Column="3" Content="+ Thêm tài khoản" Background="#C2542D" Foreground="White" FontWeight="Bold" Padding="15,5" Height="34" BorderThickness="0" Cursor="Hand" Click="BtnAddAccount_Click"/>
        </Grid>

        <!-- DataGrid Hiển thị danh sách -->
        <DataGrid x:Name="dgAccounts" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Background="White" BorderBrush="#ddd" BorderThickness="1" RowHeight="40" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding AccountId}" Width="50"/>
                <DataGridTextColumn Header="Họ và tên" Binding="{Binding FullName}" Width="180"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding Phone}" Width="110"/>
                <DataGridTextColumn Header="Quyền (Role)" Binding="{Binding Role}" Width="100"/>

                <DataGridTemplateColumn Header="Trạng thái" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#1e2632">
                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột Hành động (Sửa, Phân quyền, Khóa & Xóa) -->
                <DataGridTemplateColumn Header="Hành động" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="Sửa" Background="#2980B9" Foreground="White" Margin="0,0,5,0" Padding="10,4" BorderThickness="0" Cursor="Hand"
                                        Click="BtnEditAccount_Click"/>

                                <Button Content="Phân quyền" Background="#1e2632" Foreground="White" Margin="0,0,5,0" Padding="10,4" BorderThickness="0" Cursor="Hand"
                                        CommandParameter="{Binding AccountId}" Click="BtnChangeRole_Click"/>

                                <Button Content="Khóa/Mở" Background="#F39C12" Foreground="White" Margin="0,0,5,0" Padding="10,4" BorderThickness="0" Cursor="Hand"
                                        CommandParameter="{Binding AccountId}" Click="BtnToggleStatus_Click"/>

                                <Button Content="Xóa" Background="#E74C3C" Foreground="White" Padding="10,4" BorderThickness="0" Cursor="Hand"
                                        CommandParameter="{Binding AccountId}" Click="BtnDeleteAccount_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
