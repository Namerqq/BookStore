<Window x:Class="BookStore.View.Admin.AdminLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:BookStore.View.Shared"
        Title="Admin Dashboard — Booky Mart" Height="650" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Cố định Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Vùng hiển thị nội dung động -->
        </Grid.ColumnDefinitions>

        <!-- Nhúng Sidebar dùng chung -->
        <shared:SidebarControl Grid.Column="0"/>

        <!-- Vùng nội dung chính của từng chức năng -->
        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề trang -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Tên Chức Năng (Ví dụ: Quản lý sản phẩm)" FontSize="22" FontWeight="Bold" Foreground="#1e2632"/>
                <TextBlock Text="Mô tả ngắn gọn nghiệp vụ của trang này ở đây." FontSize="13" Foreground="#7f8c8d"/>
            </StackPanel>

            <!-- Nội dung chi tiết -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
                <TextBlock Text="[ Vùng chứa bảng dữ liệu / Form nhập liệu của thành viên ]" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#95a5a6"/>
            </Border>
        </Grid>
    </Grid>
</Window>