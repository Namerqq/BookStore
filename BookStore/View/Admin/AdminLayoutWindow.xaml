<Window x:Class="BookStore.View.Admin.AdminLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:BookStore.View.Shared"
        Title="Cổng Quản Trị — Booky Mart" Height="720" Width="1200" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="ContentCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#64748B" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR BÊN TRÁI -->
        <Border Grid.Column="0" Background="#111827">
            <shared:SidebarControl/>
        </Border>

        <!-- VÙNG NỘI DUNG CHÍNH BÊN PHẢI -->
        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="txtHeading" Text="Bảng Điều Khiển Quản Trị" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="txtSubheading" Text="Chọn chức năng tương ứng ở thanh điều hướng bên trái để bắt đầu làm việc." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Padding="32">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                    <TextBlock x:Name="txtWelcomeTitle" FontSize="20" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtRoleSummary" FontSize="14" Foreground="#475569" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
