<Window x:Class="BookStore.View.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:BookStore.View.Shared"
        Title="Đăng nhập — Booky Mart" Height="750" Width="1050" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Nút bấm màu cam bo góc -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#C2542D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#Fcfbfa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <shared:HeaderControl Grid.Row="0"/>

        <Border Grid.Row="1" Width="850" Height="480" Background="White" CornerRadius="15" BorderBrush="#e0e0e0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.5*"/>
                    <ColumnDefinition Width="5.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Banner trái -->
                <Border Grid.Column="0" Background="#1e2632" CornerRadius="15" Margin="10" Padding="30">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                            <TextBlock Text="📖" FontSize="30" Foreground="#C2542D" Margin="0,0,0,15"/>
                            <TextBlock Text="Tài khoản của bạn tại BookyMart." FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="Đăng nhập để quản lý đơn hàng, theo dõi danh sách sản phẩm yêu thích và nhận thông báo về các ưu đãi mới nhất." 
                                       FontSize="12" Foreground="#b0bec5" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Lưu trữ" FontWeight="Bold" Foreground="#C2542D" FontSize="16"/>
                                <TextBlock Text="Yêu thích" Foreground="#888" FontSize="10"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="Quản lý" FontWeight="Bold" Foreground="#C2542D" FontSize="16"/>
                                <TextBlock Text="Đơn hàng" Foreground="#888" FontSize="10"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Ưu đãi" FontWeight="Bold" Foreground="#C2542D" FontSize="16"/>
                                <TextBlock Text="Hội viên" Foreground="#888" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Form Đăng nhập phải -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="50,0">
                    <TextBlock Text="Đăng nhập" FontSize="24" FontWeight="Bold" Foreground="#1e2632"/>
                    <TextBlock Text="Chào mừng bạn quay lại Booky Mart" FontSize="12" Foreground="#888" Margin="0,5,0,30"/>

                    <TextBlock Text="Email" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="#F4F4F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="✉️" Grid.Column="0" Margin="0,0,10,0"/>
                            <TextBox x:Name="txtEmail" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Khung Mật khẩu đã thêm cơ chế Ẩn/Hiện -->
                    <TextBlock Text="Mật khẩu" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="#F4F4F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔒" Grid.Column="0" Margin="0,0,10,0"/>

                            <!-- 2 ô nhập mật khẩu chồng lên nhau -->
                            <PasswordBox x:Name="txtPassword" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtPasswordVisible" Grid.Column="1" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Visibility="Collapsed"/>

                            <TextBlock Text="👁️" Grid.Column="2" Foreground="#888" Cursor="Hand" MouseLeftButtonDown="TogglePassword_Click"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,25">
                        <CheckBox Content="Ghi nhớ đăng nhập" FontSize="11" Foreground="#555"/>
                        <TextBlock Text="Quên mật khẩu?" FontSize="11" Foreground="#C2542D" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="LinkForgotPassword_Click"/>
                    </Grid>

                    <Button Content="Đăng nhập" Style="{StaticResource PrimaryButton}" Click="BtnLogin_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="Chưa có tài khoản? " FontSize="11" Foreground="#888"/>
                        <TextBlock Text="Đăng ký ngay" FontSize="11" Foreground="#C2542D" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="LinkRegister_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>