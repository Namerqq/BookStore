<Window x:Class="BookStore.View.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập — Booky Mart" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="ĐĂNG NHẬP" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Email:"/>
            <TextBox x:Name="txtEmail" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Mật khẩu:"/>
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,20" Padding="5"/>

            <Button Content="Đăng nhập" Click="BtnLogin_Click" Padding="10" Background="#0078D7" Foreground="White" FontWeight="Bold"/>

            <!-- Link chuyển sang trang Đăng ký -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="Chưa có tài khoản? " Foreground="#7f8c8d"/>
                <TextBlock Text="Đăng ký ngay" Foreground="#C2542D" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="NavToRegister_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>