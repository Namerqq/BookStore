<Window x:Class="BookStore.View.Auth.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký tài khoản — Booky Mart" Height="550" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Tạo tài khoản mới" FontSize="26" FontWeight="Bold" Margin="0,0,0,5" Foreground="#1e2632"/>
            <TextBlock Text="Đăng ký để bắt đầu mua sắm tại Booky Mart" FontSize="14" Foreground="#7f8c8d" Margin="0,0,0,20"/>

            <TextBlock Text="Họ và tên *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFullName" Padding="8" Margin="0,0,0,15" FontSize="14"/>

            <TextBlock Text="Địa chỉ email *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Padding="8" Margin="0,0,0,15" FontSize="14"/>

            <TextBlock Text="Mật khẩu *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Padding="8" Margin="0,0,0,15" FontSize="14"/>

            <TextBlock Text="Xác nhận mật khẩu *" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtConfirmPassword" Padding="8" Margin="0,0,0,20" FontSize="14"/>

            <CheckBox x:Name="chkAgreeTerms" Content="Tôi đồng ý với Điều khoản dịch vụ và Chính sách bảo mật." Margin="0,0,0,20"/>

            <Button Content="Tạo tài khoản" Click="BtnRegister_Click" 
                    Background="#C2542D" Foreground="White" FontSize="16" FontWeight="Bold" Padding="10" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="Đã có tài khoản? " Foreground="#7f8c8d"/>
                <TextBlock Text="Đăng nhập ngay" Foreground="#C2542D" FontWeight="Bold" Cursor="Hand" MouseLeftButtonDown="NavToLogin_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>