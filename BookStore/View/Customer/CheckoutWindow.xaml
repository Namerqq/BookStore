<Window x:Class="BookStore.View.Customer.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt hàng — Booky Mart" Height="720" Width="1040" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Địa chỉ giao hàng" Style="{StaticResource SectionTitle}"/>
                                <Button Content="Quản lý địa chỉ" Style="{StaticResource SmallBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnManageAddress_Click"/>
                            </Grid>
                            <ComboBox x:Name="cboAddress" SelectedValuePath="AddressId" Padding="8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding ReceiverName, Mode=OneWay}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding ReceiverPhone, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding FullAddress}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock x:Name="txtNoAddress" Text="Bạn chưa có địa chỉ. Hãy thêm địa chỉ để đặt hàng." Foreground="#B3261E" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Sản phẩm" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl x:Name="icLines">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Warning}" Foreground="#B3261E" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=x{0}}" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat={}{0:N0}đ}" TextAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Phương thức thanh toán" Style="{StaticResource SectionTitle}"/>
                            <RadioButton x:Name="rbCod" Content="Thanh toán khi nhận hàng (COD)" IsChecked="True" Margin="0,0,0,8"/>
                            <RadioButton x:Name="rbQr" Content="Chuyển khoản qua mã VietQR"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Mã giảm giá" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="cboSaved" DisplayMemberPath="Display" Padding="6" Margin="0,0,0,8" SelectionChanged="CboSaved_SelectionChanged" ToolTip="Mã bạn đã lưu"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtVoucher" Style="{StaticResource FieldBox}" Margin="0,0,8,0" MaxLength="30" CharacterCasing="Upper"/>
                        <Button x:Name="btnApply" Grid.Column="1" Content="Áp dụng" Style="{StaticResource DarkBtn}" Click="BtnApply_Click"/>
                    </Grid>
                    <TextBlock x:Name="txtVoucherMessage" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <Button x:Name="btnRemoveVoucher" Content="Bỏ mã giảm giá" Style="{StaticResource SmallBtn}" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed" Click="BtnRemoveVoucher_Click"/>

                    <Separator Margin="0,8,0,14"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Tạm tính"/>
                        <TextBlock x:Name="txtSubtotal" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock x:Name="txtShippingLabel" Text="Phí vận chuyển"/>
                        <TextBlock x:Name="txtShipping" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Giảm giá"/>
                        <TextBlock x:Name="txtDiscount" HorizontalAlignment="Right" Foreground="#5B6B4F"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Tổng thanh toán" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTotal" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#C2542D"/>
                    </Grid>

                    <TextBlock x:Name="txtError" Foreground="#B3261E" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <Button x:Name="btnPlaceOrder" Content="Xác nhận đặt hàng" Style="{StaticResource PrimaryBtn}" Padding="14,12" Click="BtnPlaceOrder_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
