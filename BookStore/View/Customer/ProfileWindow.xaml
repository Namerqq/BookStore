<Window x:Class="BookStore.View.Customer.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:BookStore.View.Shared"
        Title="Hồ sơ của tôi — Booky Mart" Height="750" Width="1050" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#C2542D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#Fcfbfa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <shared:HeaderControl Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,40,0,40">
                <TextBlock Text="Hồ sơ của tôi" FontSize="26" FontWeight="Bold" Foreground="#1e2632" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Grid Width="850" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KHỐI 1: THÔNG TIN CÁ NHÂN -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#e0e0e0" BorderThickness="1" Padding="30">
                        <StackPanel>
                            <TextBlock Text="Thông tin cá nhân" FontSize="18" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,0,20"/>

                            <!-- Cảnh báo tài khoản nội bộ (Mặc định ẩn) -->
                            <TextBlock x:Name="txtInternalWarning" Text="Tài khoản nội bộ (Admin/Manager/Staff) không được tự thay đổi thông tin cá nhân. Vui lòng liên hệ Admin hệ thống." 
                                       Foreground="#e74c3c" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" Visibility="Collapsed"/>

                            <TextBlock Text="Email đăng nhập (Không thể thay đổi)" FontSize="11" Foreground="#888" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#f9f9f9" CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                                <TextBox x:Name="txtEmail" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#888"/>
                            </Border>

                            <TextBlock Text="Họ và tên *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#F4F4F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                                <TextBox x:Name="txtFullName" Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <TextBlock Text="Số điện thoại" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#F4F4F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,25">
                                <TextBox x:Name="txtPhone" Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <Button x:Name="BtnUpdateProfile" Content="Lưu thông tin" Style="{StaticResource PrimaryButton}" Click="BtnUpdateProfile_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- KHỐI 2: ĐỔI MẬT KHẨU -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#e0e0e0" BorderThickness="1" Padding="30">
                        <StackPanel>
                            <TextBlock Text="Đổi mật khẩu" FontSize="18" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,0,20"/>

                            <TextBlock Text="Mật khẩu hiện tại *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#F4F4F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                                <PasswordBox x:Name="txtOldPassword" Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <TextBlock Text="Mật khẩu mới *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#F4F4F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,15">
                                <PasswordBox x:Name="txtNewPassword" Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <TextBlock Text="Xác nhận mật khẩu mới *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#F4F4F5" CornerRadius="6" Padding="10,8" Margin="0,0,0,25">
                                <PasswordBox x:Name="txtConfirmNewPassword" Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <Button x:Name="BtnChangePassword" Content="Cập nhật mật khẩu" Style="{StaticResource PrimaryButton}" Background="#1e2632" Click="BtnChangePassword_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FOOTER -->
                <shared:FooterControl Margin="0,40,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>