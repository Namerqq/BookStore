<Window x:Class="BookStore.View.Customer.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giỏ hàng — Booky Mart" Height="640" Width="1000" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <TextBlock Text="Giỏ hàng của bạn" Style="{StaticResource PageTitle}"/>
                <CheckBox x:Name="chkAll" Content="Chọn tất cả" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ChkAll_Click"/>
            </Grid>

            <Grid Grid.Row="1">
                <DataGrid x:Name="dgCart" Style="{StaticResource DataTable}" RowHeight="72">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkItem_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Sản phẩm" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="46" Height="60" Background="#F5F5F5" CornerRadius="4" ClipToBounds="True" Margin="0,0,10,0">
                                            <Image Source="{Binding ThumbnailUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                                            <TextBlock Text="{Binding Warning}" Foreground="#B3261E" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Đơn giá" Width="100" Binding="{Binding UnitPrice, StringFormat={}{0:N0}đ}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Số lượng" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="−" Width="28" Style="{StaticResource SmallBtn}" Padding="0,4" Click="BtnMinus_Click"/>
                                        <TextBlock Text="{Binding Quantity}" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Content="+" Width="28" Style="{StaticResource SmallBtn}" Padding="0,4" Click="BtnPlus_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Thành tiền" Width="110" Binding="{Binding LineTotal, StringFormat={}{0:N0}đ}" FontWeight="SemiBold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Xóa" Style="{StaticResource SmallBtn}" VerticalAlignment="Center" Click="BtnRemove_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="txtEmpty" Text="Giỏ hàng đang trống." Style="{StaticResource MutedText}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtSelectedCount" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="Tạm tính:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtSubtotal" FontSize="18" FontWeight="Bold" Foreground="#C2542D" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="btnCheckout" Content="Đặt hàng" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right" Padding="28,10" Click="BtnCheckout_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
