<Window x:Class="BookStore.View.Customer.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:BookStore.View.Shared"
        Title="Booky Mart — Siêu thị sách &amp; văn phòng phẩm" Height="750" Width="1050" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== GỌI HEADER DÙNG CHUNG ==================== -->
        <shared:HeaderControl Grid.Row="0"/>

        <!-- ==================== NỘI DUNG CHÍNH (CÓ CUỘN) ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Background="#Fcfbfa">

                <!-- BANNER -->
                <Border Background="#161d26" Padding="50,40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỦ SÁCH &amp; GÓC LÀM VIỆC" FontSize="12" Foreground="#888" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Mỗi trang sách,&#x0a;mỗi nét bút -&#x0a;đều đáng lưu giữ." FontSize="32" FontWeight="Bold" Foreground="White" LineHeight="40"/>
                            <TextBlock Text="Thế giới sách và văn phòng phẩm phong phú, giao hàng nhanh chóng tận tay bạn." FontSize="13" Foreground="#b0bec5" Margin="0,15,0,20"/>
                            <Button Content="Mua sắm ngay" HorizontalAlignment="Left" Padding="15,10" Background="#C2542D" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="#C2542D" Width="110" Height="150" CornerRadius="8" Margin="0,0,10,0" Padding="10">
                                <TextBlock Text="SÁCH VĂN HỌC&#x0a;Nhà Giả Kim" Foreground="White" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                            </Border>
                            <Border Background="#1e2632" Width="110" Height="170" CornerRadius="8" Padding="10" BorderBrush="#fff" BorderThickness="1">
                                <TextBlock Text="SÁCH THIẾU NHI&#x0a;Dế Mèn" Foreground="White" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. PHẦN ƯU ĐÃI HÔM NAY (Lấy từ tbVoucher) -->
                <StackPanel Margin="40,25,40,10">
                    <TextBlock Text="ƯU ĐÃI HÔM NAY" FontSize="12" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock Text="Bóc mã, giảm liền tay" FontSize="22" FontWeight="Bold" Foreground="#1e2632" Margin="0,5,0,15"/>

                    <ItemsControl x:Name="VoucherListControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="10" Width="210" Height="90" Margin="0,0,15,15" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1e2632" CornerRadius="6">
                                            <TextBlock Text="{Binding DiscountValue, StringFormat={}{0:N0}đ}" Foreground="White" FontWeight="Bold" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding MinOrderValue, StringFormat=Đơn từ {0:N0}đ}" FontSize="10" Foreground="#666"/>
                                            <Button Content="Lưu mã" FontSize="10" Padding="5,2" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#F4EAE6" Foreground="#C2542D" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. PHẦN DANH MỤC (Lấy từ tbCategory) -->
                <StackPanel Margin="40,20,40,10">
                    <TextBlock Text="DANH MỤC" FontSize="12" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock Text="Bạn đang tìm gì hôm nay?" FontSize="22" FontWeight="Bold" Foreground="#1e2632" Margin="0,5,0,15"/>

                    <ItemsControl x:Name="CategoryListControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="10" Width="135" Height="100" Margin="0,0,15,15" Cursor="Hand">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📖" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Danh mục" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 3. PHẦN BÁN CHẠY (Lấy từ tbProduct) -->
                <StackPanel Margin="40,20,40,10">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="BÁN CHẠY" FontSize="12" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock Text="Được yêu thích nhất tuần này" FontSize="22" FontWeight="Bold" Foreground="#1e2632" Margin="0,5,0,15"/>
                        </StackPanel>
                        <TextBlock Text="Xem tất cả →" Foreground="#C2542D" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>

                    <ItemsControl x:Name="ProductListControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="10" Width="210" Height="280" Margin="0,0,15,15" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="130"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Khung chứa ảnh bìa sách lấy từ DB -->
                                        <Border Background="#f5f5f5" CornerRadius="6" ClipToBounds="True">
                                            <Grid>
                                                <!-- LƯU Ý: Đổi chữ 'ImagePath' nếu cột ảnh trong Model của bạn có tên khác (vd: ImageUrl, Cover) -->
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>

                                                <Border Background="#5b6b4f" CornerRadius="4" Width="35" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                    <TextBlock Text="Mới" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Thông tin sách -->
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                            <TextBlock Text="BOOK" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Author}" FontSize="11" Foreground="#666" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock Text="★★★★★" FontSize="10" Foreground="#f1c40f" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Giá và Nút Thêm vào giỏ -->
                                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0}đ}" FontWeight="Bold" FontSize="13" Foreground="#1e2632" VerticalAlignment="Center"/>
                                            <Border CornerRadius="14" Background="#1e2632" Width="28" Height="28" HorizontalAlignment="Right">
                                                <Button Content="+" Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0" Width="28" Height="28" Cursor="Hand"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ==================== GỌI FOOTER DÙNG CHUNG ==================== -->
                <shared:FooterControl Margin="0,20,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>