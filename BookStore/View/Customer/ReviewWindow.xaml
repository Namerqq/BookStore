<Window x:Class="BookStore.View.Customer.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đánh giá sản phẩm" Height="450" Width="480" WindowStartupLocation="CenterScreen" Background="#Fcfbfa">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề giống phong cách HomeWindow -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ĐÁNH GIÁ SẢN PHẨM" FontSize="12" Foreground="#888" FontWeight="Bold"/>
            <TextBlock Text="Chia sẻ trải nghiệm của bạn" FontSize="24" FontWeight="Bold" Foreground="#1e2632" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Chọn số sao -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Chất lượng (Số sao):" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,15,0"/>
            <ComboBox x:Name="cbRating" Width="150" Height="32" SelectedIndex="0" VerticalContentAlignment="Center">
                <ComboBoxItem Content="5 Sao ⭐⭐⭐⭐⭐" Tag="5"/>
                <ComboBoxItem Content="4 Sao ⭐⭐⭐⭐" Tag="4"/>
                <ComboBoxItem Content="3 Sao ⭐⭐⭐" Tag="3"/>
                <ComboBoxItem Content="2 Sao ⭐⭐" Tag="2"/>
                <ComboBoxItem Content="1 Sao ⭐" Tag="1"/>
            </ComboBox>
        </StackPanel>

        <!-- Ô nhập nhận xét -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Nhận xét chi tiết:" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,0,6"/>
            <TextBox x:Name="txtComment" AcceptsReturn="True" TextWrapping="Wrap" Height="130" Padding="10" BorderBrush="#e0e0e0" BorderThickness="1" Background="White" VerticalContentAlignment="Top"/>
        </StackPanel>

        <!-- Nút hành động chuẩn tông màu -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Width="95" Height="38" Margin="0,0,10,0" Background="#f0f0f0" Foreground="#333" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Content="Gửi đánh giá" Width="120" Height="38" Background="#C2542D" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSubmit_Click"/>
        </StackPanel>
    </Grid>
</Window>