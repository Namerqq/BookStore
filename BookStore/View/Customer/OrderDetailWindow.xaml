<Window x:Class="BookStore.View.Customer.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi tiết đơn hàng — Booky Mart" Height="700" Width="940" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock x:Name="txtCode" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="txtCreatedAt" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Background="#1e2632" CornerRadius="14" Padding="14,6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtStatus" Foreground="White" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Người nhận" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="txtReceiver" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtAddress" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Thanh toán" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="txtPayment" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtPaymentStatus" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="bdNotice" Background="#F4EAE6" CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                        <TextBlock x:Name="txtNotice" TextWrapping="Wrap" Foreground="#7A3419"/>
                    </Border>

                    <DataGrid x:Name="dgLines" Style="{StaticResource DataTable}" Margin="0,0,0,14" ScrollViewer.CanContentScroll="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="50"/>
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0}đ}" Width="100"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotal, StringFormat={}{0:N0}đ}" Width="110"/>
                            <DataGridTemplateColumn Header="Đánh giá" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Đánh giá" Style="{StaticResource SmallBtn}" VerticalAlignment="Center"
                                                Visibility="{Binding CanReview, Converter={StaticResource BoolToVis}}" Click="BtnReview_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Style="{StaticResource Card}" HorizontalAlignment="Right" Width="340">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Tạm tính"/>
                                <TextBlock x:Name="txtSubtotal" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Phí vận chuyển"/>
                                <TextBlock x:Name="txtShipping" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock x:Name="txtDiscountLabel" Text="Giảm giá"/>
                                <TextBlock x:Name="txtDiscount" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Tổng cộng" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtTotal" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" Foreground="#C2542D"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="btnShowQr" Content="Xem mã QR" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnShowQr_Click"/>
                <Button x:Name="btnReturn" Content="Yêu cầu hoàn hàng" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnReturn_Click"/>
                <Button x:Name="btnCancel" Content="Hủy đơn" Style="{StaticResource DangerBtn}" Margin="0,0,10,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
                <Button Content="Đóng" Style="{StaticResource QuietBtn}" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
