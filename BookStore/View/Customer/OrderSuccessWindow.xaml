<Window x:Class="BookStore.View.Customer.OrderSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt hàng thành công — Booky Mart" Height="700" Width="520" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Margin="20">
                <StackPanel>
                    <TextBlock x:Name="txtHeading" Style="{StaticResource PageTitle}" TextAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtOrderCode" FontSize="14" TextAlignment="Center" Foreground="#555555"/>
                    <TextBlock x:Name="txtAmount" FontSize="24" FontWeight="Bold" Foreground="#C2542D" TextAlignment="Center" Margin="0,12,0,14"/>

                    <StackPanel x:Name="pnlQr" Visibility="Collapsed">
                        <Image x:Name="imgQr" Width="280" Height="320" Stretch="Uniform" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtQrError" Text="Không tải được mã QR. Bạn có thể chuyển khoản theo thông tin bên dưới." Foreground="#B3261E" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtBankInfo" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock x:Name="txtDemoWarning" Text="Đây là tài khoản demo, vui lòng không chuyển tiền thật." Foreground="#B3261E" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock x:Name="txtNote" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,12,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="btnViewOrder" Content="Xem đơn hàng" Style="{StaticResource SecondaryBtn}" Margin="0,0,10,0" Click="BtnViewOrder_Click"/>
                        <Button Content="Đóng" Style="{StaticResource QuietBtn}" IsCancel="True"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
