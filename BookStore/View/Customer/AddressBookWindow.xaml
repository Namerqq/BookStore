<Window x:Class="BookStore.View.Customer.AddressBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sổ địa chỉ — Booky Mart" Height="600" Width="980" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,20,0">
                <StackPanel>
                    <TextBlock x:Name="txtFormTitle" Text="Thêm địa chỉ mới" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Tên người nhận *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtName" Style="{StaticResource FieldBox}" MaxLength="100"/>

                    <TextBlock Text="SĐT người nhận *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPhone" Style="{StaticResource FieldBox}" MaxLength="20"/>

                    <TextBlock Text="Địa chỉ cụ thể *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtAddress" Style="{StaticResource FieldBox}" MaxLength="255" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

                    <CheckBox x:Name="chkDefault" Content="Đặt làm địa chỉ mặc định" Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Làm mới" Style="{StaticResource QuietBtn}" Margin="0,0,10,0" Click="BtnClear_Click"/>
                        <Button Content="Lưu địa chỉ" Style="{StaticResource PrimaryBtn}" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid x:Name="dgAddresses" Grid.Column="1" Style="{StaticResource DataTable}" RowHeight="52">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Người nhận" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="6,0">
                                    <TextBlock Text="{Binding ReceiverName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ReceiverPhone}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Địa chỉ" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullAddress}" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock Text="Mặc định" Foreground="#C2542D" FontSize="11" FontWeight="SemiBold"
                                               Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Sửa" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="BtnEdit_Click"/>
                                    <Button Content="Mặc định" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="BtnSetDefault_Click"/>
                                    <Button Content="Xóa" Style="{StaticResource SmallBtn}" Click="BtnDelete_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
