<Window x:Class="BookStore.View.Shared.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập lý do" Height="300" Width="440" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5" Margin="0">
        <Border Style="{StaticResource Card}" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtPrompt" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                <TextBox x:Name="txtReason" Grid.Row="1" Padding="6" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Đóng" Style="{StaticResource QuietBtn}" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="Xác nhận" Style="{StaticResource PrimaryBtn}" Click="BtnOk_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
