<UserControl x:Class="BookStore.View.Shared.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Background="#1e2632" Width="220">
        <!-- Logo -->
        <TextBlock Text="Booky.Mart" Foreground="White" FontSize="20" FontWeight="Bold" Margin="20,20,20,30"/>

        <!-- Các nút menu điều hướng quản trị -->
        <Button Content="📊 Tổng quan &amp; Báo cáo" Click="MenuDashboard_Click" Background="Transparent" Foreground="#d1cfcb" HorizontalAlignment="Stretch" Padding="20,12" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand"/>
        <Button Content="📦 Quản lý Sản phẩm" Click="MenuProducts_Click" Background="Transparent" Foreground="#d1cfcb" HorizontalAlignment="Stretch" Padding="20,12" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand"/>
        <Button Content="👥 Quản lý Tài khoản" Click="MenuAccounts_Click" Background="Transparent" Foreground="#d1cfcb" HorizontalAlignment="Stretch" Padding="20,12" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand"/>
        <Button Content="🏷️ Quản lý Khuyến mãi" Click="MenuVouchers_Click" Background="Transparent" Foreground="#d1cfcb" HorizontalAlignment="Stretch" Padding="20,12" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand"/>

        <Separator Background="#34495e" Margin="15,20"/>

        <Button Content="🚪 Đăng xuất" Click="MenuLogout_Click" Background="Transparent" Foreground="#E29B8A" HorizontalAlignment="Stretch" Padding="20,12" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
</UserControl>