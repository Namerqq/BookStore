<Window x:Class="BookStore.View.Customer.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đánh giá sản phẩm — Booky Mart" Height="390" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <Border Style="{StaticResource Card}" Margin="20">
            <StackPanel>
                <TextBlock Text="Đánh giá sản phẩm" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock x:Name="txtProductName" FontWeight="SemiBold" Foreground="#1e2632" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="Chất lượng sản phẩm *" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="btnStar1" Content="★" Tag="1" FontSize="26" Width="42" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Star_Click"/>
                    <Button x:Name="btnStar2" Content="★" Tag="2" FontSize="26" Width="42" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Star_Click"/>
                    <Button x:Name="btnStar3" Content="★" Tag="3" FontSize="26" Width="42" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Star_Click"/>
                    <Button x:Name="btnStar4" Content="★" Tag="4" FontSize="26" Width="42" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Star_Click"/>
                    <Button x:Name="btnStar5" Content="★" Tag="5" FontSize="26" Width="42" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Star_Click"/>
                    <TextBlock x:Name="txtRatingLabel" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#D97706"/>
                </StackPanel>

                <TextBlock Text="Nhận xét của bạn (tối đa 1000 ký tự)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtComment" Style="{StaticResource FieldBox}" Height="96" MaxLength="1000" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hủy" Style="{StaticResource QuietBtn}" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="Gửi đánh giá" Style="{StaticResource PrimaryBtn}" Click="BtnSubmit_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
