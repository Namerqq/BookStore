<Window x:Class="BookStore.View.Customer.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:BookStore.View.Shared"
        Title="Booky Mart — Siêu thị sách &amp; văn phòng phẩm" Height="760" Width="1080" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== GỌI HEADER DÙNG CHUNG ==================== -->
        <shared:HeaderControl x:Name="HeaderBar" Grid.Row="0"/>

        <!-- ==================== NỘI DUNG CHÍNH (CÓ CUỘN) ==================== -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Background="#Fcfbfa">

                <!-- BANNER -->
                <Border Background="#161d26" Padding="50,40">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỦ SÁCH &amp; GÓC LÀM VIỆC" FontSize="12" Foreground="#888" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Mỗi trang sách,&#x0a;mỗi nét bút -&#x0a;đều đáng lưu giữ." FontSize="32" FontWeight="Bold" Foreground="White" LineHeight="40"/>
                            <TextBlock Text="Thế giới sách và văn phòng phẩm phong phú, giao hàng nhanh chóng tận tay bạn." FontSize="13" Foreground="#b0bec5" Margin="0,15,0,20"/>
                            <Button Content="Mua sắm ngay" Click="BtnShopNow_Click" HorizontalAlignment="Left" Padding="15,10" Background="#C2542D" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="#C2542D" Width="110" Height="150" CornerRadius="8" Margin="0,0,10,0" Padding="10">
                                <TextBlock Text="SÁCH VĂN HỌC&#x0a;Nhà Giả Kim" Foreground="White" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                            </Border>
                            <Border Background="#1e2632" Width="110" Height="170" CornerRadius="8" Padding="10" BorderBrush="#fff" BorderThickness="1">
                                <TextBlock Text="SÁCH THIẾU NHI&#x0a;Dế Mèn" Foreground="White" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. PHẦN ƯU ĐÃI HÔM NAY -->
                <StackPanel x:Name="VoucherSection" Margin="40,25,40,10">
                    <TextBlock Text="ƯU ĐÃI HÔM NAY" FontSize="12" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock Text="Bóc mã, giảm liền tay" FontSize="22" FontWeight="Bold" Foreground="#1e2632" Margin="0,5,0,15"/>

                    <ItemsControl x:Name="VoucherListControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="10" Width="210" Height="90" Margin="0,0,15,15" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#1e2632" CornerRadius="6">
                                            <TextBlock Text="{Binding DiscountValue, StringFormat={}{0:N0}đ}" Foreground="White" FontWeight="Bold" FontSize="11" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding MinOrderValue, StringFormat=Đơn từ {0:N0}đ}" FontSize="10" Foreground="#666"/>
                                            <Button Content="Lưu mã" Click="BtnSaveVoucher_Click" FontSize="10" Padding="5,2" Margin="0,5,0,0" HorizontalAlignment="Left" Background="#F4EAE6" Foreground="#C2542D" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. PHẦN DANH MỤC -->
                <StackPanel Margin="40,20,40,10">
                    <TextBlock Text="DANH MỤC" FontSize="12" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock Text="Bạn đang tìm gì hôm nay?" FontSize="22" FontWeight="Bold" Foreground="#1e2632" Margin="0,5,0,15"/>

                    <ItemsControl x:Name="CategoryListControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="BtnCategory_Click" Margin="0,0,15,15" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        Background="White" BorderBrush="#e0e0e0" BorderThickness="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="10" Width="135" Height="100" Padding="8">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#C2542D"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="📖" FontSize="24" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,2" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Danh mục" FontSize="10" Foreground="#888" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 3. PHẦN SẢN PHẨM -->
                <StackPanel x:Name="ProductSection" Margin="40,20,40,10">
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="txtProductSubtitle" Text="BÁN CHẠY" FontSize="12" Foreground="#888" FontWeight="Bold"/>
                            <TextBlock x:Name="txtProductTitle" Text="Được yêu thích nhất tuần này" FontSize="22" FontWeight="Bold" Foreground="#1e2632" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="cboTypeFilter" Width="145" Height="30" Margin="0,0,8,0" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="Tất cả loại" Tag="ALL" IsSelected="True"/>
                                <ComboBoxItem Content="Sách" Tag="BOOK"/>
                                <ComboBoxItem Content="Văn phòng phẩm" Tag="STATIONERY"/>
                            </ComboBox>
                            <ComboBox x:Name="cboSort" Width="145" Height="30" Margin="0,0,14,0" SelectionChanged="FilterChanged">
                                <ComboBoxItem Content="Mặc định" Tag="DEFAULT" IsSelected="True"/>
                                <ComboBoxItem Content="Mới nhất" Tag="NEWEST"/>
                                <ComboBoxItem Content="Giá tăng dần" Tag="PRICE_ASC"/>
                                <ComboBoxItem Content="Giá giảm dần" Tag="PRICE_DESC"/>
                            </ComboBox>
                            <TextBlock Text="Xem tất cả →" Foreground="#C2542D" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand"
                                       x:Name="txtViewAllProducts" MouseDown="TxtViewAllProducts_MouseDown"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="ProductListControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="10" Width="210" Height="290" Margin="0,0,15,15" Padding="12"
                                        Cursor="Hand" MouseLeftButtonUp="ProductCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="130"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Khung chứa ảnh bìa -->
                                        <Border Background="#f5f5f5" CornerRadius="6" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ThumbnailUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <!-- Thông tin -->
                                        <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding ProductTypeLabel}" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#666" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding RatingDisplay}" FontSize="11" Foreground="#D97706" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Giá và Nút Thêm vào giỏ -->
                                        <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding PriceText}" FontWeight="Bold" FontSize="13" Foreground="#1e2632" VerticalAlignment="Center"/>
                                            <Border CornerRadius="14" Background="#1e2632" Width="28" Height="28" HorizontalAlignment="Right">
                                                <Button Content="+" Click="BtnAddToCart_Click" Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0" Width="28" Height="28" Cursor="Hand" ToolTip="Thêm vào giỏ"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="txtEmptyProducts" Text="Không tìm thấy sản phẩm nào phù hợp." Foreground="#666" FontSize="13" Margin="0,8,0,16" Visibility="Collapsed"/>
                </StackPanel>

                <!-- ==================== GỌI FOOTER DÙNG CHUNG ==================== -->
                <shared:FooterControl Margin="0,20,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
