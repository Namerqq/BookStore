<UserControl x:Class="BookStore.View.Shared.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="240">

    <UserControl.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="12,4,12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7F1D1D"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#1E293B">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. PHẦN LOGO / THƯƠNG HIỆU -->
            <StackPanel Grid.Row="0" Margin="24,28,24,20">
                <TextBlock Text="Booky.Mart" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="txtRoleSubtitle" Text="Hệ thống quản lý" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                <Separator Background="#334155" Height="1" Margin="0,20,0,0" BorderThickness="0"/>
            </StackPanel>

            <!-- 2. DANH SÁCH NÚT MENU -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <Button x:Name="btnDashboard" Content="📊  Tổng quan &amp; Báo cáo" Style="{StaticResource MenuButtonStyle}" Click="MenuDashboard_Click" Visibility="Collapsed"/>
                <Button x:Name="btnProducts" Content="📦  Quản lý Sản phẩm" Style="{StaticResource MenuButtonStyle}" Click="MenuProducts_Click" Visibility="Collapsed"/>
                <Button x:Name="btnVouchers" Content="🏷  Quản lý Khuyến mãi" Style="{StaticResource MenuButtonStyle}" Click="MenuVouchers_Click" Visibility="Collapsed"/>
                <Button x:Name="btnRefunds" Content="💸  Xác nhận Hoàn tiền" Style="{StaticResource MenuButtonStyle}" Click="MenuRefunds_Click" Visibility="Collapsed"/>
                <Button x:Name="btnOrders" Content="🧾  Xử lý Đơn hàng" Style="{StaticResource MenuButtonStyle}" Click="MenuOrders_Click" Visibility="Collapsed"/>
                <Button x:Name="btnAccounts" Content="👥  Quản lý Tài khoản" Style="{StaticResource MenuButtonStyle}" Click="MenuAccounts_Click" Visibility="Collapsed"/>
                <Button x:Name="btnLogs" Content="📜  Nhật ký Hệ thống" Style="{StaticResource MenuButtonStyle}" Click="MenuLogs_Click" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 3. NÚT ĐĂNG XUẤT Ở DƯỚI CÙNG -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <Separator Background="#334155" Height="1" Margin="24,0,24,16" BorderThickness="0"/>
                <Button x:Name="btnLogout" Content="🚪  Đăng xuất" Style="{StaticResource LogoutButtonStyle}" Click="MenuLogout_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
