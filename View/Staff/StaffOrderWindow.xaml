<Window x:Class="BookStore.View.Staff.StaffOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xử lý đơn hàng — Booky Mart" Height="760" Width="1240" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Xử lý đơn hàng" Style="{StaticResource PageTitle}"/>
                <TextBox x:Name="txtSearch" Grid.Column="1" Width="240" Padding="6" Margin="0,0,10,0" VerticalContentAlignment="Center"
                         ToolTip="Tìm theo mã đơn, tên hoặc SĐT người nhận" TextChanged="TxtSearch_TextChanged"/>
                <ComboBox x:Name="cboFilter" Grid.Column="2" Width="210" Padding="8,6" SelectionChanged="CboFilter_SelectionChanged">
                    <ComboBoxItem Content="Tất cả đơn" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="Chờ thanh toán" Tag="PENDING_PAYMENT"/>
                    <ComboBoxItem Content="Chờ xác nhận" Tag="PENDING"/>
                    <ComboBoxItem Content="Đang xử lý" Tag="PROCESSING"/>
                    <ComboBoxItem Content="Đang giao" Tag="SHIPPED"/>
                    <ComboBoxItem Content="Tạm giữ" Tag="ON_HOLD"/>
                    <ComboBoxItem Content="Đã giao" Tag="DELIVERED"/>
                    <ComboBoxItem Content="Đã hủy" Tag="CANCELLED"/>
                    <ComboBoxItem Content="Yêu cầu hoàn hàng" Tag="RETURN_REQUESTED"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="dgOrders" Style="{StaticResource DataTable}" Margin="0,0,16,0" SelectionChanged="DgOrders_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderCode}" Width="170"/>
                        <DataGridTextColumn Header="Ngày đặt" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" Width="90"/>
                        <DataGridTextColumn Header="Người nhận" Binding="{Binding ReceiverName}" Width="*"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="100"/>
                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding Total, StringFormat={}{0:N0}đ}" Width="95"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <Grid>
                        <TextBlock x:Name="txtPlaceholder" Text="Chọn một đơn hàng để xử lý." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer x:Name="pnlDetail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="txtCode" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="txtStatusLine" FontWeight="SemiBold" Foreground="#C2542D" Margin="0,0,0,12"/>

                                <TextBlock Text="Người nhận" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="txtReceiver" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Thanh toán" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="txtPayment" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Gọi xác nhận" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="txtPhone" Margin="0,0,0,12"/>

                                <TextBlock Text="Sản phẩm" Style="{StaticResource FieldLabel}"/>
                                <ItemsControl x:Name="icLines" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=x{0}}" FontSize="12" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="bdNotice" Background="#F4EAE6" CornerRadius="8" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                                    <TextBlock x:Name="txtNotice" TextWrapping="Wrap" FontSize="12" Foreground="#7A3419"/>
                                </Border>

                                <TextBlock x:Name="txtActionHint" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>

                                <WrapPanel x:Name="pnlActions">
                                    <Button x:Name="btnConfirmPayment" Content="Xác nhận đã nhận tiền" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8" Click="BtnConfirmPayment_Click"/>
                                    <Button x:Name="btnConfirmOrder" Content="Xác nhận đơn" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8" Click="BtnConfirmOrder_Click"/>
                                    <Button x:Name="btnResume" Content="Xử lý lại đơn" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8" Click="BtnResume_Click"/>
                                    <Button x:Name="btnPhoneOk" Content="Đã gọi được khách" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,8" Click="BtnPhoneOk_Click"/>
                                    <Button x:Name="btnPhoneFail" Content="Không liên hệ được" Style="{StaticResource QuietBtn}" Margin="0,0,8,8" Click="BtnPhoneFail_Click"/>
                                    <Button x:Name="btnShip" Content="Chuyển giao hàng" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8" Click="BtnShip_Click"/>
                                    <Button x:Name="btnDelivered" Content="Đã giao thành công" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8" Click="BtnDelivered_Click"/>
                                    <Button x:Name="btnFailed" Content="Giao thất bại, tạm giữ" Style="{StaticResource QuietBtn}" Margin="0,0,8,8" Click="BtnFailed_Click"/>
                                    <Button x:Name="btnReturnOk" Content="Đã nhận lại hàng" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,8" Click="BtnReturnOk_Click"/>
                                    <Button x:Name="btnReturnReject" Content="Từ chối hoàn hàng" Style="{StaticResource DangerBtn}" Margin="0,0,8,8" Click="BtnReturnReject_Click"/>
                                    <Button x:Name="btnCancel" Content="Hủy đơn" Style="{StaticResource DangerBtn}" Margin="0,0,8,8" Click="BtnCancel_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
