<Window x:Class="BookStore.View.Admin.SystemLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhật ký hệ thống" Height="620" Width="920" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Grid Background="#F4F4F5" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Grid.Row="0" Text="Nhật ký Hoạt động Hệ thống" FontSize="24" FontWeight="Bold" Foreground="#1e2632" Margin="0,0,0,20"/>

        <!-- Thanh tìm kiếm -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#ddd" BorderThickness="1" Padding="10,5">
                <Grid>
                    <TextBlock x:Name="txtSearchPlaceholder" Text="🔍 Tìm kiếm hành động, tài khoản..." Foreground="#999" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="Làm mới" HorizontalAlignment="Right" Background="#1e2632" Foreground="White" Padding="15,6" BorderThickness="0" Cursor="Hand" Click="BtnRefresh_Click"/>
        </Grid>

        <!-- DataGrid Hiển thị Log -->
        <DataGrid x:Name="dgLogs" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Background="White" BorderBrush="#ddd" BorderThickness="1" RowHeight="35" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150"/>
                <DataGridTextColumn Header="Account ID" Binding="{Binding AccountId}" Width="90"/>
                <DataGridTextColumn Header="Người thực hiện" Binding="{Binding Account.Email}" Width="200"/>
                <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
