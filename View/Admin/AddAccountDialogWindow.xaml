<Window x:Class="BookStore.View.Admin.AddAccountDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm tài khoản mới" Height="530" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Background="#F8FAFC" Margin="20">
        <StackPanel>
            <TextBlock Text="Thông tin tài khoản mới" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18"/>

            <TextBlock Text="Họ và tên *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFullName" Height="32" Padding="6,4" Margin="0,0,0,12" MaxLength="100"/>

            <TextBlock Text="Email đăng nhập *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Height="32" Padding="6,4" Margin="0,0,0,12" MaxLength="100"/>

            <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPhone" Height="32" Padding="6,4" Margin="0,0,0,12" MaxLength="20"/>

            <TextBlock Text="Mật khẩu * (8-64 ký tự, gồm chữ và số)" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPassword" Height="32" Padding="6,4" Margin="0,0,0,12" MaxLength="64"/>

            <TextBlock Text="Quyền (Role) *" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbRoles" Height="32" SelectedIndex="0" Margin="0,0,0,22">
                <ComboBoxItem Content="CUSTOMER" Tag="CUSTOMER"/>
                <ComboBoxItem Content="STAFF" Tag="STAFF"/>
                <ComboBoxItem Content="MANAGER" Tag="MANAGER"/>
                <ComboBoxItem Content="ADMIN" Tag="ADMIN"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="80" Height="35" Background="#E2E8F0" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click"/>
                <Button Content="Tạo tài khoản" Width="110" Height="35" Background="#C2542D" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
