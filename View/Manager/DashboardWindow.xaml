<Window x:Class="BookStore.View.Manager.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard Báo Cáo &amp; Thống Kê" Height="680" Width="1050" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" Background="#Fcfbfa">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề & Bộ lọc thời gian -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="BÁO CÁO &amp; THỐNG KÊ" FontSize="12" Foreground="#888" FontWeight="Bold"/>
                <TextBlock Text="Tổng quan hệ thống" FontSize="24" FontWeight="Bold" Foreground="#1e2632" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpFromDate" Width="130" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpToDate" Width="130" Margin="0,0,12,0" VerticalContentAlignment="Center"/>
                <Button Content="Xem báo cáo" Background="#1e2632" Foreground="White" FontWeight="Bold" Padding="14,6" BorderThickness="0" Cursor="Hand" Click="BtnFilter_Click"/>
            </StackPanel>
        </Grid>

        <!-- Thẻ thống kê (Cards) -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ĐƠN THÀNH CÔNG" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotalOrders" FontSize="20" FontWeight="Bold" Foreground="#1e2632" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="DOANH THU" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock x:Name="lblTotalRevenue" FontSize="18" FontWeight="Bold" Foreground="#27ae60" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#e0e0e0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="LỢI NHUẬN GỘP" FontSize="10" Foreground="#888" FontWeight="Bold"/>
                    <TextBlock x:Name="lblGrossProfit" FontSize="18" FontWeight="Bold" Foreground="#e67e22" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border CornerRadius="8" Padding="15" VerticalAlignment="Center">
                <Button Content="Xuất CSV Sản Phẩm" Background="#C2542D" Foreground="White" FontWeight="Bold" Height="36" BorderThickness="0" Cursor="Hand" Click="BtnExportCsv_Click"/>
            </Border>
        </UniformGrid>

        <!-- Bảng dữ liệu chi tiết -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header=" Top 5 Bán Chạy " Grid.Column="0" Margin="0,0,10,0" FontWeight="Bold" Foreground="#1e2632">
                <DataGrid x:Name="dgTopSelling" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" Background="White" BorderBrush="#e0e0e0" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Đã bán" Binding="{Binding TotalQuantitySold}" Width="70"/>
                        <DataGridTextColumn Header="Doanh thu" Binding="{Binding TotalRevenueGenerated, StringFormat={}{0:N0}đ}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header=" Cảnh báo Tồn kho thấp (&lt;= 10) " Grid.Column="1" Margin="10,0,0,0" FontWeight="Bold" Foreground="#1e2632">
                <DataGrid x:Name="dgLowStock" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0" Background="White" BorderBrush="#e0e0e0" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="85"/>
                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Tồn kho" Binding="{Binding StockQuantity}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
