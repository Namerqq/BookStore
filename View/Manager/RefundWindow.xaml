<Window x:Class="BookStore.View.Manager.RefundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận hoàn tiền — Booky Mart" Height="600" Width="1040" WindowStartupLocation="CenterOwner" Language="vi-VN" Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStore;component/View/Shared/OrderFlowStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F4F4F5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Xác nhận hoàn tiền" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Chỉ xác nhận sau khi đã chuyển khoản hoàn tiền thật cho khách." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <DataGrid x:Name="dgRefunds" Style="{StaticResource DataTable}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderCode}" Width="170"/>
                        <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="140"/>
                        <DataGridTextColumn Header="SĐT" Binding="{Binding ReceiverPhone}" Width="100"/>
                        <DataGridTextColumn Header="Lý do" Binding="{Binding RefundReason}" Width="*"/>
                        <DataGridTextColumn Header="Số tiền" Binding="{Binding Total, StringFormat={}{0:N0}đ}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Xem" Style="{StaticResource SmallBtn}" Margin="0,0,6,0" Click="BtnView_Click"/>
                                        <Button Content="Đã hoàn tiền" Style="{StaticResource SmallBtn}" Background="#C2542D" Foreground="White" Click="BtnRefund_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="txtEmpty" Text="Không có đơn nào đang chờ hoàn tiền." Style="{StaticResource MutedText}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
