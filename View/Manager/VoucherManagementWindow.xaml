<Window x:Class="BookStore.View.Manager.VoucherManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Voucher khuyến mãi" Height="740" Width="1200" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Grid Background="#F4F4F5" Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Cột trái: Form điền thông tin -->
            <ColumnDefinition Width="360"/>
            <!-- Cột phải: DataGrid -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM THÊM / SỬA -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#ddd" BorderThickness="1" Padding="20" Margin="0,0,20,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Thông tin Voucher" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <!-- ID ẩn dùng để nhận biết Thêm hay Sửa -->
                    <TextBlock x:Name="txtVoucherId" Visibility="Collapsed" Text="0"/>

                    <TextBlock Text="Mã Code *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCode" Height="32" Padding="6,4" Margin="0,0,0,10" CharacterCasing="Upper" MaxLength="30"/>

                    <TextBlock Text="Loại giảm giá *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cbDiscountType" Height="32" Margin="0,0,0,10" SelectionChanged="CbDiscountType_SelectionChanged">
                        <ComboBoxItem Content="Giảm cố định (VNĐ)" Tag="FIXED" IsSelected="True"/>
                        <ComboBoxItem Content="Giảm theo phần trăm (%)" Tag="PERCENTAGE"/>
                    </ComboBox>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblDiscountValue" Text="Mức giảm (VNĐ) *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDiscount" Height="32" Padding="6,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Giảm tối đa (VNĐ)" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtMaxDiscountCap" Height="32" Padding="6,4" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Đơn tối thiểu (VNĐ)" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtMinOrder" Height="32" Padding="6,4" Margin="0,0,0,10" Text="0"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ngày bắt đầu *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpStartDate" Height="32"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ngày kết thúc *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <DatePicker x:Name="dpEndDate" Height="32"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tổng lượt dùng *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtMaxUsageLimit" Height="32" Padding="6,4" Text="100"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lượt / khách *" FontSize="11" Foreground="#555" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtPerCustomerLimit" Height="32" Padding="6,4" Text="1"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Làm mới" Width="90" Height="35" Background="#eee" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnClearForm_Click"/>
                        <Button Content="Lưu Voucher" Width="110" Height="35" Background="#C2542D" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- DANH SÁCH & CÔNG CỤ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="White" CornerRadius="6" BorderBrush="#ddd" BorderThickness="1" Padding="10,0">
                    <Grid>
                        <TextBlock x:Name="txtSearchPlaceholder" Text="🔍 Tìm mã code..." Foreground="#999" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="txtSearch" Height="34" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </Border>

                <!-- Xuất CSV -->
                <Button Grid.Column="1" Content="⬇ Xuất File CSV" HorizontalAlignment="Right" Background="#2ecc71" Foreground="White" FontWeight="Bold" Padding="15,0" Height="35" BorderThickness="0" Cursor="Hand" Click="BtnExportCSV_Click"/>
            </Grid>

            <DataGrid x:Name="dgVouchers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      Background="White" BorderBrush="#ddd" BorderThickness="1" RowHeight="40" SelectionChanged="DgVouchers_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding VoucherId}" Width="45"/>
                    <DataGridTextColumn Header="Mã Voucher" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding DiscountType}" Width="90"/>
                    <DataGridTextColumn Header="Mức giảm" Binding="{Binding DiscountValue, StringFormat={}{0:N0}}" Width="85"/>
                    <DataGridTextColumn Header="Đơn tối thiểu" Binding="{Binding MinOrderValue, StringFormat={}{0:N0}}" Width="95"/>
                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" Width="85"/>
                    <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" Width="85"/>
                    <DataGridTextColumn Header="Lượt" Binding="{Binding MaxUsageLimit}" Width="55"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="80"/>

                    <DataGridTemplateColumn Header="Hành động" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Bật/Tắt" Background="#1e2632" Foreground="White" Padding="10,4" BorderThickness="0" Cursor="Hand"
                                        CommandParameter="{Binding VoucherId}" Click="BtnToggle_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
